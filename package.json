{
  "name": "@wrmsoftware/tf-generator",
  "type": "module",
  "version": "0.6.0",
  "author": "Thada Wangthammang",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/dts/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/dts/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "src",
    "package.json"
  ],
  "scripts": {
    "get": "cd examples/azurerm-webapp && bun install && bun run start",
    "check": "tsc -b tsconfig.json",
    "check:watch": "tsc -b tsconfig.json -w",
    "prepublishOnly": "bun run build",
    "release": "bun run build && release-it",
    "format": "prettier --write src",
    "build:watch": "tsc -b tsconfig.build.json -w",
    "build": "bun format && bun build-esm && bun build-cjs && bun build-annotate",
    "build-esm": "tsc -b tsconfig.build.json",
    "build-cjs": "babel dist/esm --plugins @babel/transform-export-namespace-from --plugins @babel/transform-modules-commonjs --out-dir dist/cjs --source-maps",
    "build-annotate": "babel dist --plugins annotate-pure-calls --out-dir dist --source-maps",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.5",
    "@babel/core": "^7.24.5",
    "@babel/plugin-transform-export-namespace-from": "^7.24.1",
    "@babel/plugin-transform-modules-commonjs": "^7.24.1",
    "@types/bun": "^1.2.1",
    "babel-plugin-annotate-pure-calls": "^0.4.0",
    "prettier": "^3.4.2",
    "release-it": "^17.3.0",
    "typescript": "^5.7.2",
    "type-fest": "^4.33.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WRM-Software/tf-generator.git"
  },
  "homepage": "https://github.com/WRM-Software/tf-generator",
  "license": "MIT"
}
